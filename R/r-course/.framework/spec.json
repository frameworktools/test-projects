{
  "spec_version": 1,
  "name": "r-course",
  "type": "course",
  "language": "r",
  "core_files": true,
  "settings_layout": "flat",
  "tools": {
    "quarto": true,
    "renv": false
  },
  "author": {
    "name": "Your Name",
    "email": "your.email@example.com",
    "affiliation": "Your Institution"
  },
  "directories": {
    "data": "data",
    "slides": "slides",
    "assignments": "assignments",
    "course_docs": "course_docs",
    "readings": "readings",
    "notebooks": "modules",
    "cache": "cache",
    "functions": "functions",
    "scripts": "scripts"
  },
  "extra_directories": {},
  "render_dirs": {
    "slides": "rendered/slides",
    "assignments": "rendered/assignments",
    "course_docs": "rendered/course_docs",
    "modules": "rendered/modules"
  },
  "packages": {
    "use_renv": false,
    "default_packages": {
      "dplyr": {
        "source": "cran",
        "auto_attach": true
      },
      "ggplot2": {
        "source": "cran",
        "auto_attach": true
      },
      "tidyr": {
        "source": "cran",
        "auto_attach": true
      },
      "stringr": {
        "source": "cran",
        "auto_attach": true
      },
      "readr": {
        "source": "cran",
        "auto_attach": true
      },
      "purrr": {
        "source": "cran",
        "auto_attach": false
      },
      "tibble": {
        "source": "cran",
        "auto_attach": true
      },
      "forcats": {
        "source": "cran",
        "auto_attach": true
      },
      "lubridate": {
        "source": "cran",
        "auto_attach": false
      },
      "glue": {
        "source": "cran",
        "auto_attach": false
      },
      "here": {
        "source": "cran",
        "auto_attach": false
      },
      "lme4": {
        "source": "cran",
        "auto_attach": false
      }
    }
  },
  "git": {
    "use_git": true,
    "hooks": {
      "data_security": false
    },
    "gitignore_content": "# Framework - Course Project\n# ================================================================================\n# Gitignore for course/educational materials with slides, assignments, and modules.\n# ================================================================================\n\n# ============================================================================\n# PRIVATE DATA - NEVER COMMIT\n# ============================================================================\n\n# Private directories (anywhere in project tree)\n**/private/**\n**/*_private/**\n\n# ============================================================================\n# SECRETS AND CREDENTIALS - NEVER COMMIT\n# ============================================================================\n\n.env\n.env.local\n.env.*.local\n.Renviron\n.httr-oauth\n**/credentials/**\n**/secrets/**\n*.key\n*.pem\n\n# ============================================================================\n# UTILITY & CACHE - SAFE TO IGNORE\n# ============================================================================\n\n# Temporary processing directories\n**/cache/**\n**/scratch/**\n**/tmp/**\n**/temp/**\n\n# Logs (run logs, cluster job output)\n**/logs/**\nslurm-*.out\n\n# Rendered output (render_dirs and _quarto.yml's output-dir: rendered/)\n/rendered/\n\n# ============================================================================\n# R ENVIRONMENT\n# ============================================================================\n\n# R session files\n.Rproj.user/\n.Rhistory\n.RData\n.Ruserdata\n.Rapp.history\n.Rprofile\n\n# renv (package management)\n# NOTE: Consider committing renv.lock for reproducibility\nrenv/library/\nrenv/local/\nrenv/cellar/\nrenv/lock/\nrenv/python/\nrenv/sandbox/\nrenv/staging/\n\n# ============================================================================\n# FRAMEWORK INTERNALS\n# ============================================================================\n\nframework.db\nframework.db-wal\nframework.db-shm\n.initiated\n.framework_renv_enabled\n.framework_scaffolded\n\n# ============================================================================\n# QUARTO / RMARKDOWN ARTIFACTS\n# ============================================================================\n\n# Quarto adds these two lines, in this form, unless they are here already\n/.quarto/\n**/*.quarto_ipynb\n# A folder with its own _quarto.yml gets its own .quarto/\n.quarto/\n_freeze/\n*_cache/\n*_files/\n\n# ============================================================================\n# PYTHON (if using reticulate)\n# ============================================================================\n\n__pycache__/\n.ipynb_checkpoints/\n*.pyc\n.pytest_cache/\nvenv/\n.venv/\n\n# ============================================================================\n# IDE & SYSTEM FILES\n# ============================================================================\n\n# IDE - personal settings only (commit workspace settings if desired)\n.idea/\n.vscode/.history/\n.positron/.history/\n.history/\n\n# macOS\n.DS_Store\n.AppleDouble\n.LSOverride\n\n# Windows\nThumbs.db\nehthumbs.db\n\n# Linux\n*~\n\n# ============================================================================\n# CLOUD/AWS CONFIG\n# ============================================================================\n\n.aws/\n.config/\n\n# ============================================================================\n# TEMPORARY FILES\n# ============================================================================\n\n*.tmp\n*.log\n*.bak\n*.swp\n*~"
  },
  "ai": {
    "enabled": true,
    "assistants": {
      "claude": true
    },
    "agents_md": "stub"
  },
  "scaffold": {
    "seed_on_scaffold": false,
    "seed": "123",
    "set_theme_on_scaffold": true,
    "ggplot_theme": "theme_minimal",
    "source_all_functions": true,
    "ide": "vscode",
    "workflow": "quarto"
  },
  "quarto": {
    "html": {
      "format": "html",
      "embed_resources": true,
      "theme": "default",
      "toc": true,
      "toc_depth": 3,
      "code_fold": false,
      "code_tools": false,
      "highlight_style": "github"
    },
    "revealjs": {
      "format": "revealjs",
      "theme": "default",
      "incremental": false,
      "slide_number": true,
      "transition": "slide",
      "background_transition": "fade",
      "controls": true,
      "progress": true,
      "center": true,
      "highlight_style": "github"
    },
    "render_dir": "rendered/slides"
  },
  "connections": {
    "default_database": "framework",
    "databases": {
      "framework": {
        "driver": "sqlite",
        "database": "framework.db"
      }
    },
    "storage_buckets": {}
  },
  "security": {
    "sensitive": false
  },
  "env": {
    "POSTGRES_HOST": "",
    "POSTGRES_PORT": "5432",
    "POSTGRES_DB": "",
    "POSTGRES_SCHEMA": "public",
    "POSTGRES_USER": "",
    "POSTGRES_PASSWORD": "",
    "S3_BUCKET": "",
    "S3_ACCESS_KEY": "",
    "S3_SECRET_KEY": "",
    "S3_REGION": "",
    "S3_ENDPOINT": "",
    "S3_SESSION_TOKEN": ""
  },
  "data_hooks": {},
  "files": {},
  "skills": {
    "framework-workflow": {
      "package": true
    },
    "framework-data": {
      "package": true
    },
    "framework-packages": {
      "package": true
    },
    "framework-outputs": {
      "package": true
    },
    "ggplot2-exploring": {
      "package": true
    },
    "ggplot2-publishing": {
      "package": true
    }
  },
  "source": {
    "origin": "r",
    "framework_version": "2.0.1"
  }
}
